NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgres://quantpilot:local-development-only@localhost:5432/quantpilot
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace-with-at-least-32-random-characters
REGISTRATION_CODE=choose-a-private-invitation-code
FYERS_APP_ID=
FYERS_APP_SECRET=
LIVE_TRADING_ENABLED=false
BROKER_APP_APPROVED=false
DEDICATED_EGRESS_CONFIRMED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=QuantPilot <noreply@example.com>
# Optional comma-separated exchange holiday dates, YYYY-MM-DD. Keep current.
NSE_HOLIDAYS=
MCX_HOLIDAYS=
# Conservative commodity session cut-off; set to your approved intraday schedule.
MCX_SQUARE_OFF=23:00
