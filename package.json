{
  "name": "quantpilot-platform",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16 <23"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "worker": "node dist/worker.js",
    "migrate": "node dist/migrate.js",
    "test": "vitest run",
    "check": "npm run build && npm test",
    "demo": "tsx src/demo-server.ts",
    "start:free": "node dist/free-server.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "csv-parse": "^7.0.3",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.1",
    "nodemailer": "^10.3.1",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@types/node": "^22.18.0",
    "@types/nodemailer": "^7.0.3",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "yaml": "^2.8.1"
  }
